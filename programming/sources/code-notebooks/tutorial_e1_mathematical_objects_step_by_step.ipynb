   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Our Vector Class vs NumPy\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Our class\n",
    "our_vec = Vector([3, 4])\n",
    "\n",
    "# NumPy\n",
    "numpy_vec = np.array([3, 4])\n",
    "\n",
    "print(\"\\nOperation          | Our Class        | NumPy\")\n",
    "print(\"-\" * 60)\n",
    "print(f\"Creation           | Vector([3, 4])   | np.array([3, 4])\")\n",
    "print(f\"Magnitude          | vec.magnitude    | np.linalg.norm(vec)\")\n",
    "print(f\"Addition           | v1 + v2          | v1 + v2\")\n",
    "print(f\"Scaling            | 2 * v1           | 2 * v1\")\n",
    "print(f\"Dot product        | v1.dot(v2)       | np.dot(v1, v2)\")\n",
    "print(f\"Normalize          | v1.normalize()   | v1 / np.linalg.norm(v1)\")\n",
    "\n",
    "print(\"\\nKey Differences:\")\n",
    "print(\"  Our class:\")\n",
    "    "    print(\"    • Simple and educational\")\n",
    "print(\"    • Domain-specific methods (angle_with, etc.)\")\n",
    "print(\"    • Easy to understand implementation\")\n",
