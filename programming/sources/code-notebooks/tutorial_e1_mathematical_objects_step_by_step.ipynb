   "source": [
    "---\n",
    "\n",
    "## 3. The Problem with Functions: Tracking State <a id='problems'></a>\n",
    "\n",
    "The function-based approach works, but let's see where it gets messy."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def demonstrate_function_problems() -> None:\n",
    "    \"\"\"\n",
    "    Show the problems with the function-based approach.\n",
    "    \"\"\"\n",
    "    \n",
    "    print(\"Scenario: Working with Multiple Polynomials\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    # We have several polynomials we're working with\n",
    "    poly1 = [1, 2, 1]      # p₁(x) = 1 + 2x + x²\n",
    "    poly2 = [2, -1]        # p₂(x) = 2 - x\n",
    "    poly3 = [1, 0, 1]      # p₃(x) = 1 + x²\n",
    "    \n",
    "    # Problem 1: Lots of variables to track\n",
    "    print(\"\\nProblem 1: Variable Management\")\n",
    "    print(\"-\" * 60)\n",
    "    print(\"We need separate variables for:\")\n",
    "    print(\"  - poly1, poly2, poly3 (the polynomials)\")\n",
    "    print(\"  - Maybe poly1_deriv, poly2_deriv (derivatives)\")\n",
    "    print(\"  - poly_sum, poly_product (results of operations)\")\n",
    "    print(\"  - Easy to lose track or mix them up!\")\n",
    "    \n",
    "    # Problem 2: Can't tell what a list represents\n",
    "    print(\"\\nProblem 2: What does this list mean?\")\n",
    "    print(\"-\" * 60)\n",
    "    mystery_list = [1, 2, 1]\n",
    "    print(f\"  {mystery_list}\")\n",
    "    print(\"  Is this:\")\n",
    "    print(\"    - A polynomial? [1, 2, 1] = 1 + 2x + x²\")\n",
    "    print(\"    - A vector? [1, 2, 1] = (1, 2, 1)\")\n",
    "    print(\"    - Just a list of numbers?\")\n",
    "    print(\"  We can't tell from the data alone!\")\n",
    "    \n",
    "    # Problem 3: Easy to make mistakes\n",
    "    print(\"\\nProblem 3: Error-Prone Operations\")\n",
    "    print(\"-\" * 60)\n",
    "    print(\"  # Want to compute: (p₁ + p₂) * p₃\")\n",
    "    print(\"  result = multiply_polynomials(\")\n",
    "    print(\"      add_polynomials(poly1, poly2),\")\n",
    "    print(\"      poly3\")\n",
    "    print(\"  )\")\n",
    "    print(\"  \")\n",
    "    print(\"  Easy mistakes:\")\n",
    "    print(\"    - Forget to store intermediate result\")\n",
    "    print(\"    - Use wrong function (add vs multiply)\")\n",
    "    print(\"    - Pass arguments in wrong order\")\n",
    "    \n",
    "    # Problem 4: Verbose code\n",
    "    print(\"\\nProblem 4: Verbose and Repetitive\")\n",
    "    print(\"-\" * 60)\n",
    "    print(\"  # With functions:\")\n",
    "    print(\"  temp1 = add_polynomials(poly1, poly2)\")\n",
    "    print(\"  temp2 = multiply_polynomials(temp1, poly3)\")\n",
    "    print(\"  result = derivative_polynomial(temp2)\")\n",
    "    print(\"  \")\n",
    "    print(\"  # What we'd like to write:\")\n",
    "    print(\"  result = ((poly1 + poly2) * poly3).derivative()\")\n",
    "    print(\"  \")\n",
    "    print(\"  Much clearer what we're doing!\")\n",
    "    \n",
    "    # Problem 5: Can't easily add new features\n",
    "    print(\"\\nProblem 5: Hard to Extend\")\n",
    "    print(\"-\" * 60)\n",
    "    print(\"  Want to add a new feature (e.g., find roots)?\")\n",
    "    print(\"  - Need to write a new function\")\n",
    "    print(\"  - Need to remember to call it with right arguments\")\n",
    "    print(\"  - Polynomial doesn't 'know' about this feature\")\n",
    "    print(\"  \")\n",
    "    print(\"  With classes, we can add methods to the polynomial itself!\")\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"Solution: Use Object-Oriented Programming!\")\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "demonstrate_function_problems()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### What We Need\n",
    "\n",
    "A better way to work with polynomials that:\n",
    "1. **Encapsulates** the coefficients with their operations\n",
    "2. **Self-documenting**: Clear that something is a polynomial\n",
    "3. **Natural syntax**: Use `+`, `*`, etc. instead of function calls\n",
    "4. **Extensible**: Easy to add new features\n",
    "5. **Safe**: Harder to make mistakes\n",
    "\n",
    "This is exactly what **classes** give us!\n",
    "\n",
    "---\n",
    "\n",
    "## 4. Introducing the Polynomial Class <a id='polynomial-class'></a>\n",
    "\n",
    "Let's build a Polynomial class that wraps our coefficients and operations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Polynomial:\n",
    "    \"\"\"A polynomial with real coefficients.\n",
    "    \n",
    "    This class encapsulates polynomial coefficients and provides\n",
    "    natural operations on them.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, coefficients: List[float]) -> None:\n",
    "        \"\"\"\n",
    "        Create a polynomial from coefficients.\n",
    "        \n",
    "        Args:\n",
    "            coefficients: [a0, a1, a2, ...] for a0 + a1*x + a2*x² + ...\n",
    "        \"\"\"\n",
    "        # Remove trailing zeros for canonical form\n",
    "        while len(coefficients) > 1 and coefficients[-1] == 0:\n",
    "            coefficients.pop()\n",
    "        \n",
    "        self.coefficients = coefficients if coefficients else [0]\n",
    "    \n",
    "    def evaluate(self, x_value: float) -> float:\n",
    "        \"\"\"Evaluate the polynomial at a point.\"\"\"\n",
    "        result = 0\n",
    "        for power, coeff in enumerate(self.coefficients):\n",
    "            result += coeff * (x_value ** power)\n",
    "        return result\n",
    "    \n",
    "    def __call__(self, x_value: float) -> float:\n",
    "        \"\"\"Allow polynomial to be called like a function: p(5)\"\"\"\n",
    "        return self.evaluate(x_value)\n",
    "    \n",
    "    def __add__(self, other: 'Polynomial') -> 'Polynomial':\n",
    "        \"\"\"Add two polynomials using + operator.\"\"\"\n",
    "        max_len = max(len(self.coefficients), len(other.coefficients))\n",
    "        \n",
    "        coeffs1 = self.coefficients + [0] * (max_len - len(self.coefficients))\n",
    "        coeffs2 = other.coefficients + [0] * (max_len - len(other.coefficients))\n",
    "        \n",
    "        new_coeffs = [c1 + c2 for c1, c2 in zip(coeffs1, coeffs2)]\n",
    "        \n",
    "        return Polynomial(new_coeffs)\n",
    "    \n",
    "    def __mul__(self, other: 'Polynomial') -> 'Polynomial':\n",
    "        \"\"\"Multiply two polynomials using * operator.\"\"\"\n",
    "        result_degree = (len(self.coefficients) - 1) + (len(other.coefficients) - 1)\n",
    "        result = [0] * (result_degree + 1)\n",
    "        \n",
    "        for i, c1 in enumerate(self.coefficients):\n",
    "            for j, c2 in enumerate(other.coefficients):\n",
    "                result[i + j] += c1 * c2\n",
    "        \n",
    "        return Polynomial(result)\n",
    "    \n",
    "    def derivative(self) -> 'Polynomial':\n",
    "        \"\"\"Compute the derivative.\"\"\"\n",
    "        if len(self.coefficients) == 1:\n",
    "            return Polynomial([0])\n",
    "        \n",
    "        new_coeffs = [\n",
    "            i * self.coefficients[i] \n",
    "            for i in range(1, len(self.coefficients))\n",
    "        ]\n",
    "        \n",
    "        return Polynomial(new_coeffs)\n",
    "    \n",
    "    def __repr__(self) -> str:\n",
    "        \"\"\"Create a nice string representation.\"\"\"\n",
    "        if all(c == 0 for c in self.coefficients):\n",
    "            return \"0\"\n",
    "        \n",
    "        terms = []\n",
    "        for i, coeff in enumerate(self.coefficients):\n",
    "            if coeff == 0:\n",
    "                continue\n",
    "            \n",
    "            if i == 0:\n",
    "                terms.append(f\"{coeff}\")\n",
    "            elif i == 1:\n",
    "                if coeff == 1:\n",
    "                    terms.append(\"x\")\n",
    "                else:\n",
    "                    terms.append(f\"{coeff}*x\")\n",
    "            else:\n",
    "                if coeff == 1:\n",
    "                    terms.append(f\"x^{i}\")\n",
    "                else:\n",
    "                    terms.append(f\"{coeff}*x^{i}\")\n",
    "        \n",
    "        return ' + '.join(terms).replace('+ -', '- ')"
   ]
  },
